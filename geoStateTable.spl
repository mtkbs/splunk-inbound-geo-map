| tstats summariesonly=true count from datamodel=Network_Traffic.All_Traffic where (All_Traffic.dest=xxxxx/nn OR All_Traffic.dest=xxxxx/nn OR All_Traffic.dest=xxxxx/nn OR All_Traffic.dest=xxxxx/nn OR All_Traffic.dest=xxxxx/nn) by All_Traffic.src, All_Traffic.action
| rename "All_Traffic.*" as "*"
| where NOT cidrmatch("10.0.0.0/8", src) AND NOT cidrmatch("172.16.0.0/12", src) AND NOT cidrmatch("192.168.0.0/16", src) AND NOT cidrmatch("xxxxx/nn", src) AND NOT cidrmatch("xxxxx/nn", src) AND NOT cidrmatch("xxxxx/nn", src) AND NOT cidrmatch("xxxxx/nn", src) AND NOT cidrmatch("xxxxx/nn", src)
| where src!="0.0.0.0"
| iplocation src
| stats sum(eval(if(action="allowed",count,0))) as allowed sum(eval(if(action="blocked",count,0))) as blocked sum(eval(if(action="unknown",count,0))) as unknown sum(count) as total by src, City, Region, Country
| sort - total
| head 50
